# Get a free OpenRouter API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_key_here
# Primary model (OpenRouter model id, e.g. openai/gpt-4o-mini)
OPENROUTER_MODEL=openai/gpt-4o-mini
# Comma-separated fallbacks tried when the primary model is busy (429/503)
OPENROUTER_FALLBACK_MODELS=anthropic/claude-3.5-haiku,google/gemini-2.0-flash-001