# Get a free OpenRouter API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_key_here
# Primary model (OpenRouter model id, e.g. nvidia/nemotron-3.5-lightning:free)
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# Comma-separated fallbacks tried when the primary model is busy (429/503)
OPENROUTER_FALLBACK_MODELS=dots-studio/dots-3-note-preview:free,google/gemma-4-31b-it:free